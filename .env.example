# RTSP Camera Credentials and Network Configuration
RTSP_USERNAME=admin
RTSP_PASSWORD=your_camera_password
RTSP_IP=192.168.1.100
RTSP_PORT=554
RTSP_PATH=/

# Optional: Directly override with a full RTSP URL
# RTSP_URL=rtsp://admin:password@192.168.1.100:554/live

# Detection & Tracking settings
MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IMAGE_SIZE=640
COUNTING_LINE_POSITION=0.6

# CVAT Annotation Server Configuration
CVAT_URL=http://localhost:8080
CVAT_USERNAME=your_cvat_username
CVAT_PASSWORD=your_cvat_password
